<?xml version="1.0" encoding="UTF-8"?>
<!--
  Hand-written reference migrations of the synthetic corpus. They prove the
  equivalence harness end to end (`cobalt equiv`), and the support package is
  the runtime the agents may use. The harness compiles with plain javac
  inside the sandbox; this pom is for building with Maven when online.
-->
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <groupId>cobalt.migrated</groupId>
  <artifactId>synthetic-baselines</artifactId>
  <version>0.1.0</version>
  <packaging>jar</packaging>

  <properties>
    <maven.compiler.release>21</maven.compiler.release>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
  </properties>
</project>
